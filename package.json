{
  "name": "shapeit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write src tests index.html vite.config.js package.json README.md AGENTS.md",
    "format:check": "prettier --check src tests index.html vite.config.js package.json README.md AGENTS.md",
    "dev:server": "wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "prettier": "^3.9.10",
    "react-test-renderer": "^18.3.1",
    "vite": "^6.0.0",
    "wrangler": "^4.154.0"
  }
}
